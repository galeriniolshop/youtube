# Copy the values into Streamlit Cloud > Settings > Secrets.
# Never commit real credentials.

YOUTUBE_CLIENT_ID = "your-client-id.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET = "your-client-secret"
YOUTUBE_REDIRECT_URI = "https://your-app-name.streamlit.app"

# Optional: enables the predefined OAuth quick-connect profile in app.py.
# Add the real value only in Streamlit Cloud Secrets, never in this file.
PREDEFINED_YOUTUBE_CLIENT_SECRET = "your-predefined-client-secret"

# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY = "replace-with-a-fernet-key"

OLLAMA_API_KEY = "your-ollama-cloud-api-key"
OLLAMA_MODEL = "gpt-oss:20b"
OLLAMA_BASE_URL = "https://ollama.com/api"
